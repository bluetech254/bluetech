# =============================================================================
# admin/.env.local.example
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env — they are in .gitignore.
# This file IS committed — it must contain NO real credentials.
#
# For production, set all these variables in your deployment
# environment (Vercel dashboard / cPanel environment variables).
# =============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
# Backend API base URL — no trailing slash
# Dev:  http://localhost:8000
# Prod: https://api.yourdomain.com  (set in deployment env, NOT here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Business Info (used in receipts, emails, etc.) ───────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=Blue Technology
NEXT_PUBLIC_BUSINESS_ADDRESS=1KM behind Kenyatta University, Nairobi
NEXT_PUBLIC_BUSINESS_EMAIL=bluetechnology58@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=0707 454 182
NEXT_PUBLIC_BUSINESS_TAGLINE=Let's build the future together, one device at a time.
