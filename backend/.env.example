# =============================================================================
# backend/.env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# This file is committed — it must contain NO real credentials.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (Supabase): get values from Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Prod (cPanel PostgreSQL) — when migrating, comment out Supabase vars above
# and uncomment this line:
# DATABASE_URL=postgresql://db_user:db_password@localhost:5432/db_name

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of allowed origins (no trailing slash, no spaces)
# Dev:  http://localhost:3001,http://localhost:5173
# Prod: https://fixit-bluetechnology.co.ke,https://admin.fixit-bluetechnology.co.ke
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173

# ── SMS (BlessedTexts Bulk SMS) ───────────────────────────────────────────────
BLESSEDTEXTS_API_KEY=your_blessedtexts_api_key_here
# Optional overrides — defaults shown, only set if you need to change them:
# BLESSEDTEXTS_SENDER_ID=23107
# BLESSEDTEXTS_API_URL=https://sms.blessedtexts.com/api/sms/v1/sendsms

# ── Payments: M-Pesa Daraja ───────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_shortcode_or_paybill
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-api-domain.com/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox
# Optional overrides — defaults shown:
# MPESA_API_URL_PROD=https://api.safaricom.co.ke
# MPESA_API_URL_SANDBOX=https://sandbox.safaricom.co.ke

# ── Payments: Paystack ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
# Frontend base URL — used to build Paystack callback_url
# Dev:  http://localhost:3001   Prod: https://fixit-bluetechnology.co.ke
FRONTEND_URL=http://localhost:3001
# Optional override:
# PAYSTACK_API_URL=https://api.paystack.co

# ── AWS SES (email — optional, leave blank to disable) ───────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_SENDER_EMAIL=no-reply@yourdomain.com

# ── Google Maps (optional — leave blank to disable Places autocomplete) ───────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional override:
# GOOGLE_PLACES_API_URL=https://maps.googleapis.com/maps/api/place/autocomplete/json

# ── Admin (first-time seed password — change immediately after first login) ───
ADMIN_PASSWORD=change_this_password_immediately
