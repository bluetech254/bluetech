# .env.production — Production Configuration (PostgreSQL Backend)
# 
# ⚠️  CRITICAL: NEVER commit this file to git
# This file contains sensitive credentials
# 
# Setup instructions:
# 1. Copy this file to .env.production (outside git tracking)
# 2. Fill in all values with actual production credentials
# 3. Set file permissions: chmod 600 .env.production
# 4. Use in deployment: source .env.production && python -m uvicorn app.main:app

# ========================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================================================

# Database backend (postgresql for production, supabase for dev)
DATABASE_TYPE=postgresql

# PostgreSQL connection details (from cPanel setup)
DB_HOST=your-cpanel-domain.com      # Replace with actual cPanel domain/IP
DB_PORT=5432                         # Default PostgreSQL port
DB_NAME=cpanel_username_bluetech_prod  # Includes cPanel username prefix
DB_USER=cpanel_username_bluetech_user  # Includes cPanel username prefix
DB_PASSWORD=your_secure_password_here  # 20+ chars, mix upper/lower/numbers/symbols

# ========================================================================
# APPLICATION CONFIGURATION
# ========================================================================

# Deployment environment
ENVIRONMENT=production

# API settings
API_PORT=8000
API_HOST=0.0.0.0
WORKERS=4

# Enable/disable debug mode (always FALSE in production)
DEBUG=false

# ========================================================================
# AUTHENTICATION & SECURITY
# ========================================================================

# JWT token secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long

# Token expiry (in hours)
ACCESS_TOKEN_EXPIRY=24
REFRESH_TOKEN_EXPIRY=7

# ========================================================================
# PAYMENT GATEWAYS
# ========================================================================

# M-Pesa (Daraja API)
MPESA_ENV=production              # production or sandbox
MPESA_CONSUMER_KEY=your_key_here
MPESA_CONSUMER_SECRET=your_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_SHORTCODE=123456
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/webhook

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_your_key_here
PAYSTACK_SECRET_KEY=sk_live_your_secret_here
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/v1/payments/paystack/webhook

# ========================================================================
# SMS GATEWAY (BlessedTexts)
# ========================================================================

BLESSED_TEXTS_API_KEY=your_api_key_here
BLESSED_TEXTS_SENDER_ID=BlueTech

# ========================================================================
# EMAIL CONFIGURATION (Optional)
# ========================================================================

EMAIL_FROM=noreply@your-domain.com
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email@your-domain.com
EMAIL_PASSWORD=your_email_password_here

# ========================================================================
# MONITORING & LOGGING
# ========================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable request logging
REQUEST_LOGGING=true

# ========================================================================
# PRODUCTION DEPLOYMENT NOTES
# ========================================================================

# 1. File Permissions
#    chmod 600 .env.production
#    This prevents other users from reading sensitive credentials

# 2. In Systemd Service
#    [Service]
#    EnvironmentFile=/path/to/.env.production
#    ExecStart=/usr/bin/python -m uvicorn app.main:app --host ${API_HOST} --port ${API_PORT}

# 3. In Docker
#    docker run --env-file .env.production ... image

# 4. In cPanel Deployment
#    source /path/to/.env.production
#    export DATABASE_TYPE DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD
#    python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

# 5. Verify Configuration
#    curl http://localhost:8000/health/db
#    Response: {"status": "healthy", "database": "connected"}

# ========================================================================
# CREDENTIAL ROTATION SCHEDULE
# ========================================================================

# Rotate these credentials every 90 days (for security best practices):
# - DB_PASSWORD
# - JWT_SECRET
# - Payment gateway keys
# - API keys

# Document rotation date here:
# Last rotated: [DATE]
# Next rotation: [DATE]
