# scripts/.env.example — Required environment variables for seed.js and migrate.js
#
# Copy this file to scripts/.env and fill in your values.
# NEVER commit the .env file — it contains database credentials.
#
# These connect directly to Postgres (bypassing the Supabase API layer).
# Get the values from: Supabase Dashboard → Project Settings → Database

# Supabase direct Postgres connection
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password

# For tag_products.py — uses the Supabase REST API instead of direct Postgres
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
